{
  "name": "forkarena-launch-video",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "node audio/synth.ts",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts",
    "draft": "remotion render src/index.ts LaunchVideo out/draft.mp4 --scale=0.5 --crf=26",
    "demo-audio": "node audio/demo-mix.ts && ffmpeg -y -i public/demo-vo/mix-raw.wav -af loudnorm=I=-14:TP=-1.5:LRA=11 -ar 48000 -c:a pcm_s16le public/demo-vo/mix.wav",
    "demo": "remotion render src/index.ts Demo out/forkarena-demo.mp4 --codec=h264 --crf=16 --audio-bitrate=320k --pixel-format=yuv420p",
    "render": "remotion render src/index.ts LaunchVideo out/forkarena-launch.mp4 --codec=h264 --crf=16 --audio-bitrate=320k --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.532",
    "@remotion/google-fonts": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
